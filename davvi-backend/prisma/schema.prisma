generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model medicines {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(150)
  price       Decimal @db.Decimal(10, 2)
  description String?
}
